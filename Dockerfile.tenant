# Multi-stage build for production Next.js tenant portal
FROM node:20-alpine AS base
RUN npm install -g pnpm@8
WORKDIR /app

# Dependencies stage
FROM base AS dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY packages/frontend-tenant/package.json ./packages/frontend-tenant/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

# Build stage
FROM base AS build
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages ./packages
COPY . .

# Build shared package
RUN cd packages/shared && pnpm build

# Build tenant frontend with standalone output
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=https://propertymanager-1-api.onrender.com
RUN cd packages/frontend-tenant && pnpm build

# Production stage
FROM node:20-alpine AS production
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002

# Copy standalone build
COPY --from=build /app/packages/frontend-tenant/.next/standalone ./
COPY --from=build /app/packages/frontend-tenant/.next/static ./packages/frontend-tenant/.next/static
COPY --from=build /app/packages/frontend-tenant/public ./packages/frontend-tenant/public

# Expose port
EXPOSE 3002

# Start application using the standalone server
CMD ["node", "packages/frontend-tenant/server.js"]
