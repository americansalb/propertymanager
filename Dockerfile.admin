# Multi-stage build for production Vite admin portal
FROM node:20-alpine AS base
RUN npm install -g pnpm@8
WORKDIR /app

# Dependencies stage
FROM base AS dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY packages/frontend-admin/package.json ./packages/frontend-admin/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

# Build stage
FROM base AS build
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages ./packages
COPY . .

# Set the API URL for production build
ENV VITE_API_URL=https://propertymanager-1-api.onrender.com/api/v1

# Build shared package
RUN cd packages/shared && pnpm build

# Build admin frontend
RUN cd packages/frontend-admin && pnpm build

# Production stage - use nginx to serve static files
FROM nginx:alpine AS production

# Copy built static files
COPY --from=build /app/packages/frontend-admin/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.admin.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
