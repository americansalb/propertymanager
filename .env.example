# ── Core ─────────────────────────────────────────────────────────────────────
# The app NEVER touches tables outside its own Postgres schema. If DATABASE_URL
# has no ?schema= parameter, APP_DB_SCHEMA is appended automatically.
DATABASE_URL="postgresql://villagemembers:villagemembers@localhost:5432/villagemembers"
APP_DB_SCHEMA="villagemembers_app"

# Sessions (generate: openssl rand -base64 48)
SESSION_SECRET=""

# Public URL of the app (used in emails + Stripe return URLs)
APP_URL="http://localhost:3000"

# Brand (one-line rebrand)
BRAND_NAME="VillageMembers"
BRAND_DOMAIN="villagemembers.org"

# ── Redis (rate limiting; keys are prefixed vm: to coexist with other services)
REDIS_URL="redis://localhost:6379"

# ── Email (Milestone 1.7) ────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="VillageMembers <no-reply@villagemembers.org>"

# ── Stripe (Milestone 1.6 — TEST keys until launch) ──────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# ── Fees (basis points) ──────────────────────────────────────────────────────
PLATFORM_FEE_RENT_BPS="0"
MARKETPLACE_TAKE_RATE_BPS="1000"

# ── Seeding ──────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL="jobs@aalb.org"
SUPER_ADMIN_PASSWORD=""
SEED_DEMO="false"
