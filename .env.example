# PropertyMaster Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV="development"
API_PORT=3001
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
FRONTEND_ADMIN_URL="http://localhost:3000"
FRONTEND_TENANT_URL="http://localhost:3002"
COOKIE_DOMAIN="localhost"

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://propertymaster:dev_password_change_in_production@localhost:5432/propertymaster_dev?schema=public"

# For production with connection pooling (e.g., PgBouncer)
# DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=10"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT Secret - MUST be changed in production (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="15m"

# Security settings
BCRYPT_ROUNDS=12

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Option 1: Gmail API (Recommended for production with Google Workspace)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Use OAuth Playground to get refresh token: https://developers.google.com/oauthplayground
# GMAIL_CLIENT_ID="xxxxx.apps.googleusercontent.com"
# GMAIL_CLIENT_SECRET="GOCSPX-xxxxx"
# GMAIL_REFRESH_TOKEN="1//xxxxx"

# Option 2: SendGrid
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxx"

# Option 3: SMTP (Development with Mailhog or any SMTP provider)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false
SMTP_FROM="noreply@propertymaster.io"

# Email sender identity
EMAIL_FROM="noreply@propertymaster.io"
EMAIL_FROM_NAME="PropertyMaster"

# ============================================================================
# FILE STORAGE
# ============================================================================
# Provider: 'local' or 's3'
STORAGE_PROVIDER="local"
UPLOAD_MAX_SIZE_MB=10

# Local storage path (for development)
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 Configuration (for production)
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# ============================================================================
# STRIPE PAYMENTS
# ============================================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Subscription Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_ID_STARTER="price_xxxxx"
STRIPE_PRICE_ID_PROFESSIONAL="price_xxxxx"
STRIPE_PRICE_ID_ENTERPRISE="price_xxxxx"

# ============================================================================
# REDIS (Optional - for caching, sessions, queues)
# ============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Sentry DSN for error tracking (get from sentry.io)
SENTRY_DSN=""

# Log level: error, warn, info, debug
LOG_LEVEL="info"

# Enable structured JSON logging in production
LOG_FORMAT="pretty"  # pretty | json

# ============================================================================
# CORS & SECURITY
# ============================================================================
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================================================
# PRODUCTION DATABASE (for Docker)
# ============================================================================
# POSTGRES_USER="propertymaster"
# POSTGRES_PASSWORD="secure_random_password_here"
# POSTGRES_DB="propertymaster"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# FEATURE_AUTO_PAY=true
# FEATURE_TENANT_PORTAL=true
# FEATURE_DOCUMENT_UPLOAD=true
# FEATURE_EMAIL_NOTIFICATIONS=true

# ============================================================================
# INTEGRATION KEYS (Optional)
# ============================================================================
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"

# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
