# Database
DATABASE_URL="postgresql://propertymaster:dev_password_change_in_production@localhost:5432/propertymaster_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@propertymaster.io"

# App
NODE_ENV="development"
API_PORT=3001
FRONTEND_ADMIN_URL="http://localhost:3000"
FRONTEND_TENANT_URL="http://localhost:3002"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# File Storage
UPLOAD_MAX_SIZE_MB=10
STORAGE_PROVIDER="local" # local | s3
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
