{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/frontend-admin && pnpm build",
  "devCommand": "cd packages/frontend-admin && pnpm dev",
  "installCommand": "pnpm install",
  "framework": null,
  "outputDirectory": "packages/frontend-admin/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-backend-url.railway.app/api/v1/:path*"
    }
  ]
}
