// PropertyMaster - Database Schema
// Multi-tenant, ACID-compliant schema for enterprise property management

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANCY & USER MANAGEMENT
// ============================================================================

enum UserRole {
  SUPER_ADMIN      // Platform admin
  ORGANIZATION_ADMIN // Company owner
  PROPERTY_MANAGER
  ACCOUNTANT
  LEASING_AGENT
  MAINTENANCE_TECH
  TENANT
  VENDOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      OrganizationType

  // Branding
  logoUrl   String?
  primaryColor String?

  // Subscription & Billing
  plan      SubscriptionPlan @default(TRIAL)
  stripeCustomerId String? @unique

  // Settings
  settings  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users     User[]
  properties Property[]
  chartOfAccounts ChartOfAccounts[]
  vendors   Vendor[]
  bankAccounts BankAccount[]
  events    Event[]
  leaseTemplates LeaseTemplate[]
  owners    Owner[]

  @@index([slug])
}

enum OrganizationType {
  PROPERTY_MANAGER
  OWNER_OPERATOR
  ENTERPRISE
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String

  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?

  role          UserRole
  status        UserStatus @default(ACTIVE)

  // Multi-tenant
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Security
  emailVerified Boolean  @default(false)
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  lastLoginAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdTransactions Transaction[]
  assignedWorkOrders WorkOrder[]
  auditLogs      AuditLog[]
  events         Event[]

  @@index([organizationId])
  @@index([email])
}

// ============================================================================
// PROPERTY & UNIT MANAGEMENT
// ============================================================================

enum PropertyType {
  MULTIFAMILY
  SINGLE_FAMILY
  COMMERCIAL
  MIXED_USE
  STUDENT_HOUSING
  SENIOR_LIVING
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_CONSTRUCTION
}

model Property {
  id          String   @id @default(cuid())

  // Basic Info
  name        String
  type        PropertyType
  status      PropertyStatus @default(ACTIVE)

  // Address
  address1    String
  address2    String?
  city        String
  state       String
  zipCode     String
  country     String   @default("US")

  // Details
  yearBuilt   Int?
  totalUnits  Int
  squareFeet  Int?

  // Financial
  acquisitionDate DateTime?
  acquisitionCost Decimal? @db.Decimal(15, 2)

  // Multi-tenant
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Settings
  settings    Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  units       Unit[]
  accounts    Account[]
  workOrders  WorkOrder[]
  vendors     PropertyVendor[]
  photos      PropertyPhoto[]
  owners      PropertyOwner[]

  @@index([organizationId])
  @@index([status])
}

enum UnitType {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_PLUS_BED
  COMMERCIAL
}

enum UnitStatus {
  VACANT
  OCCUPIED
  VACANT_RENTED // Rented but not moved in
  NOTICE
  MAINTENANCE
}

model Unit {
  id          String   @id @default(cuid())

  // Identification
  unitNumber  String
  floor       Int?
  type        UnitType
  status      UnitStatus @default(VACANT)

  // Physical details
  bedrooms    Int
  bathrooms   Decimal  @db.Decimal(3, 1)
  squareFeet  Int?

  // Financial
  marketRent  Decimal  @db.Decimal(10, 2)

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  leases      Lease[]
  workOrders  WorkOrder[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
}

// ============================================================================
// LEASING & TENANTS
// ============================================================================

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum LeaseType {
  FIXED_TERM
  MONTH_TO_MONTH
  COMMERCIAL
}

model Lease {
  id          String   @id @default(cuid())

  status      LeaseStatus @default(DRAFT)
  type        LeaseType

  // Dates
  startDate   DateTime
  endDate     DateTime?
  moveInDate  DateTime?
  moveOutDate DateTime?
  noticeDate  DateTime?

  // Financial terms
  monthlyRent Decimal  @db.Decimal(10, 2)
  securityDeposit Decimal @db.Decimal(10, 2)

  // Auto-pay settings
  autoPayEnabled Boolean @default(false)
  autoPayDay     Int?    // Day of month (1-28) when auto-pay runs
  autoPayPaymentMethodId String? // Stripe payment method ID

  // Lease terms
  terms       Json     @default("{}")
  documentUrl String?

  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenants     Tenant[]
  charges     Charge[]

  @@index([unitId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([autoPayEnabled])
}

model Tenant {
  id          String   @id @default(cuid())

  // Personal info
  firstName   String
  lastName    String
  email       String
  phone       String

  // Emergency contact
  emergencyContact  String?
  emergencyPhone    String?
  emergencyContactName  String?  // Legacy field, use emergencyContact
  emergencyContactPhone String?  // Legacy field, use emergencyPhone

  // Linked user account (for portal access)
  userId      String?  @unique

  // Portal access
  portalEnabled     Boolean  @default(false)
  portalPassword    String?
  lastPortalLogin   DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?

  // Stripe integration for payments
  stripeCustomerId String? @unique

  leaseId     String
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  isPrimary   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  payments    Payment[]
  maintenanceRequests MaintenanceRequest[]
  messages    TenantMessage[]

  @@index([leaseId])
  @@index([email])
  @@index([portalEnabled])
}

// ============================================================================
// FINANCIAL CORE - CHART OF ACCOUNTS
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  // Assets
  CASH
  ACCOUNTS_RECEIVABLE
  SECURITY_DEPOSITS_HELD
  FIXED_ASSETS

  // Liabilities
  ACCOUNTS_PAYABLE
  SECURITY_DEPOSITS_LIABILITY
  LOANS_PAYABLE

  // Equity
  OWNER_EQUITY
  RETAINED_EARNINGS

  // Revenue
  RENTAL_INCOME
  LATE_FEES
  PARKING_INCOME
  AMENITY_FEES
  OTHER_INCOME

  // Expenses
  MAINTENANCE
  UTILITIES
  INSURANCE
  PROPERTY_TAX
  MANAGEMENT_FEES
  MARKETING
  PAYROLL
  OTHER_EXPENSE
}

model ChartOfAccounts {
  id            String   @id @default(cuid())

  accountNumber String
  name          String
  type          AccountType
  subType       AccountSubType

  description   String?
  isActive      Boolean  @default(true)

  // Multi-tenant
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts      Account[]
  journalEntries JournalEntry[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([type])
}

// Property-level GL Account
model Account {
  id          String   @id @default(cuid())

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  coaId       String
  chartOfAccount ChartOfAccounts @relation(fields: [coaId], references: [id])

  balance     Decimal  @db.Decimal(15, 2) @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalEntries JournalEntry[]

  @@index([propertyId])
  @@index([coaId])
}

// ============================================================================
// FINANCIAL CORE - TRANSACTIONS & JOURNAL ENTRIES
// ============================================================================

enum TransactionType {
  CHARGE
  PAYMENT
  REFUND
  ADJUSTMENT
  JOURNAL_ENTRY
}

enum TransactionStatus {
  PENDING
  POSTED
  VOID
  RECONCILED
}

model Transaction {
  id          String   @id @default(cuid())

  type        TransactionType
  status      TransactionStatus @default(PENDING)

  amount      Decimal  @db.Decimal(15, 2)
  description String

  transactionDate DateTime
  postDate    DateTime?

  // Reference
  referenceType String? // "Lease", "WorkOrder", "Vendor", etc.
  referenceId   String?

  // Audit
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalEntries JournalEntry[]

  @@index([transactionDate])
  @@index([status])
  @@index([referenceType, referenceId])
}

// Double-entry bookkeeping
model JournalEntry {
  id          String   @id @default(cuid())

  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])

  coaId       String
  chartOfAccount ChartOfAccounts @relation(fields: [coaId], references: [id])

  // Debit or Credit
  debit       Decimal  @db.Decimal(15, 2) @default(0)
  credit      Decimal  @db.Decimal(15, 2) @default(0)

  memo        String?

  createdAt   DateTime @default(now())

  @@index([transactionId])
  @@index([accountId])
}

// ============================================================================
// ACCOUNTS RECEIVABLE (AR)
// ============================================================================

enum ChargeType {
  RENT
  LATE_FEE
  PET_FEE
  PARKING
  AMENITY
  UTILITY
  NSF_FEE
  DAMAGE
  OTHER
}

enum ChargeStatus {
  PENDING
  POSTED
  PAID
  PARTIALLY_PAID
  VOID
}

model Charge {
  id          String   @id @default(cuid())

  leaseId     String
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  type        ChargeType
  status      ChargeStatus @default(PENDING)

  amount      Decimal  @db.Decimal(10, 2)
  amountPaid  Decimal  @db.Decimal(10, 2) @default(0)

  description String
  dueDate     DateTime
  postDate    DateTime?

  // Recurring
  isRecurring Boolean  @default(false)
  recurringRuleId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  payments    PaymentAllocation[]

  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
}

enum PaymentMethod {
  ACH
  CREDIT_CARD
  DEBIT_CARD
  CHECK
  CASH
  WIRE_TRANSFER
  MONEY_ORDER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  amount      Decimal  @db.Decimal(10, 2)

  // Payment processor integration
  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  // Check/Money Order details
  checkNumber String?

  paymentDate DateTime
  depositDate DateTime?

  memo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  allocations PaymentAllocation[]

  @@index([tenantId])
  @@index([status])
  @@index([paymentDate])
  @@index([stripePaymentIntentId])
}

// Payment allocation to charges
model PaymentAllocation {
  id          String   @id @default(cuid())

  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  chargeId    String
  charge      Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([chargeId])
}

// ============================================================================
// ACCOUNTS PAYABLE (AP)
// ============================================================================

enum VendorType {
  MAINTENANCE
  LANDSCAPING
  CLEANING
  PLUMBING
  ELECTRICAL
  HVAC
  GENERAL_CONTRACTOR
  SUPPLIER
  UTILITY
  PROFESSIONAL_SERVICES
  OTHER
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Vendor {
  id          String   @id @default(cuid())

  // Basic info
  companyName String
  contactName String?
  email       String?
  phone       String?

  type        VendorType
  status      VendorStatus @default(ACTIVE)

  // Address
  address1    String?
  address2    String?
  city        String?
  state       String?
  zipCode     String?

  // Tax info
  taxId       String?
  w9Url       String?

  // Payment info
  paymentTerms String?   // "Net 30", etc.
  defaultPaymentMethod PaymentMethod?

  // Insurance & compliance
  insuranceExpiryDate DateTime?
  insuranceCertUrl    String?
  licenseNumber       String?
  licenseExpiryDate   DateTime?

  // Multi-tenant
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  properties  PropertyVendor[]
  bills       Bill[]
  workOrders  WorkOrder[]

  @@index([organizationId])
  @@index([status])
}

// Many-to-many: Vendors approved for specific properties
model PropertyVendor {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  isPreferred Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@unique([propertyId, vendorId])
  @@index([propertyId])
  @@index([vendorId])
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  VOID
  OVERDUE
}

model Bill {
  id          String   @id @default(cuid())

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  status      BillStatus @default(DRAFT)

  // Bill details
  billNumber  String?
  amount      Decimal  @db.Decimal(15, 2)

  billDate    DateTime
  dueDate     DateTime
  paidDate    DateTime?

  description String

  // Document (AI-ingested invoice)
  documentUrl String?
  ocrData     Json?    // AI-extracted data

  // Reference to work order, property, etc.
  workOrderId String?
  propertyId  String?

  memo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@index([workOrderId])
}

// ============================================================================
// BANK RECONCILIATION
// ============================================================================

enum BankAccountType {
  CHECKING
  SAVINGS
  TRUST_ACCOUNT
}

model BankAccount {
  id          String   @id @default(cuid())

  accountName String
  accountType BankAccountType

  bankName    String
  accountNumber String  // Last 4 digits only
  routingNumber String?

  currentBalance Decimal @db.Decimal(15, 2) @default(0)

  // Plaid integration
  plaidAccessToken String?
  plaidItemId      String?
  plaidAccountId   String?

  isActive    Boolean  @default(true)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bankTransactions BankTransaction[]

  @@index([organizationId])
}

enum BankTransactionStatus {
  PENDING
  CLEARED
  RECONCILED
}

model BankTransaction {
  id          String   @id @default(cuid())

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  status      BankTransactionStatus @default(PENDING)

  transactionDate DateTime
  amount      Decimal  @db.Decimal(15, 2)
  description String

  // Plaid data
  plaidTransactionId String? @unique
  merchantName       String?
  category           String[]

  // Manual reconciliation
  matchedTransactionId String? @unique
  reconciledAt         DateTime?
  reconciledBy         String?

  createdAt   DateTime @default(now())

  @@index([bankAccountId])
  @@index([status])
  @@index([transactionDate])
}

// ============================================================================
// OPERATIONS - WORK ORDERS & MAINTENANCE
// ============================================================================

enum WorkOrderType {
  MAINTENANCE
  REPAIR
  INSPECTION
  TURNOVER
  EMERGENCY
  PREVENTIVE
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum WorkOrderStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id             String   @id @default(cuid())
  organizationId String

  title       String
  description String
  type        WorkOrderType
  priority    WorkOrderPriority @default(MEDIUM)
  status      WorkOrderStatus   @default(SUBMITTED)

  // Location
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])

  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])

  location    String?  // "Lobby", "Roof", etc.

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  vendorId    String?
  vendor      Vendor? @relation(fields: [vendorId], references: [id])

  // Dates
  requestedDate DateTime @default(now())
  scheduledDate DateTime?
  completedDate DateTime?

  // Cost
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)

  // Tenant-submitted info
  tenantReportedBy String?
  tenantPhone      String?
  permissionToEnter Boolean @default(false)

  // Completion
  completionNotes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  attachments WorkOrderAttachment[]
  statusHistory WorkOrderStatusHistory[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([vendorId])
}

model WorkOrderAttachment {
  id          String   @id @default(cuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  fileUrl     String
  fileName    String
  fileType    String   // "image/jpeg", etc.
  fileSize    Int

  uploadedBy  String?
  description String?

  createdAt   DateTime @default(now())

  @@index([workOrderId])
}

model WorkOrderStatusHistory {
  id          String   @id @default(cuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus

  changedBy   String
  notes       String?

  createdAt   DateTime @default(now())

  @@index([workOrderId])
}

// ============================================================================
// AUDIT & COMPLIANCE
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PAYMENT_PROCESSED
  DOCUMENT_VIEWED
}

model AuditLog {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  action      AuditAction
  entityType  String   // "Lease", "Payment", "WorkOrder", etc.
  entityId    String

  ipAddress   String?
  userAgent   String?

  changes     Json?    // Before/after snapshot

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// ANALYTICS & FEATURE TRACKING
// ============================================================================

model Event {
  id             String   @id @default(cuid())

  // Event identification
  name           String   // e.g., "property_created", "modal_opened", "report_generated"
  category       String?  // e.g., "property_management", "financial", "user_interaction"

  // Context
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Metadata (flexible JSON for event-specific data)
  properties     Json     @default("{}")

  // Session tracking
  sessionId      String?

  // Request metadata
  ipAddress      String?
  userAgent      String?
  url            String?

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([name])
  @@index([category])
  @@index([createdAt])
  @@index([sessionId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_REMINDER
  AUTOPAY_UPCOMING
  AUTOPAY_PROCESSED
  AUTOPAY_FAILED
  LEASE_EXPIRING
  LEASE_EXPIRED
  LATE_FEE_APPLIED
  WORK_ORDER_UPDATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

model Notification {
  id          String   @id @default(cuid())

  type        NotificationType
  status      NotificationStatus @default(PENDING)
  channel     NotificationChannel @default(EMAIL)

  // Recipient
  recipientEmail String?
  recipientPhone String?
  recipientUserId String?

  // Content
  subject     String
  body        String   @db.Text
  htmlBody    String?  @db.Text

  // Reference
  referenceType String? // "Lease", "Payment", "Charge", etc.
  referenceId   String?

  // Tracking
  sentAt      DateTime?
  readAt      DateTime?
  errorMessage String?

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([recipientUserId])
  @@index([createdAt])
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json

  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// TENANT PORTAL
// ============================================================================

enum MaintenanceRequestStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceRequestPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

model MaintenanceRequest {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Request details
  title       String
  description String   @db.Text
  category    String   // "Plumbing", "Electrical", "HVAC", "Appliance", "Other"
  priority    MaintenanceRequestPriority @default(MEDIUM)
  status      MaintenanceRequestStatus @default(SUBMITTED)

  // Location
  location    String?  // Specific area within unit

  // Permission
  permissionToEnter Boolean @default(false)
  preferredTimes    String?

  // Photos
  photos      String[] @default([])

  // Resolution
  resolvedAt  DateTime?
  resolution  String?

  // Link to work order
  workOrderId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

enum MessageDirection {
  TENANT_TO_MANAGEMENT
  MANAGEMENT_TO_TENANT
}

model TenantMessage {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  direction   MessageDirection
  subject     String?
  content     String   @db.Text

  // Attachments
  attachments String[] @default([])

  // Read status
  isRead      Boolean  @default(false)
  readAt      DateTime?

  // Reply tracking
  parentId    String?
  parent      TenantMessage? @relation("MessageReplies", fields: [parentId], references: [id])
  replies     TenantMessage[] @relation("MessageReplies")

  // Sender info (for management messages)
  senderName  String?
  senderId    String?

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([direction])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================================================
// PROPERTY PHOTOS (Phase 115)
// ============================================================================

model PropertyPhoto {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitId      String?

  // Photo details
  url         String
  thumbnailUrl String?
  fileName    String
  fileSize    Int
  mimeType    String

  // Metadata
  caption     String?
  category    String?  // "exterior", "interior", "amenity", "floor_plan"
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)

  // Upload info
  uploadedBy  String?

  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@index([unitId])
  @@index([category])
}

// ============================================================================
// LEASE TEMPLATES (Phase 116)
// ============================================================================

model LeaseTemplate {
  id          String   @id @default(cuid())

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Template content
  content     String   @db.Text  // HTML or markdown template
  variables   Json     @default("[]")  // List of merge fields

  // Settings
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  leaseType   LeaseType?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
}

// ============================================================================
// TENANT SCREENING (Phase 117)
// ============================================================================

enum ScreeningStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ScreeningResult {
  APPROVED
  CONDITIONAL
  DENIED
  PENDING
}

model TenantScreening {
  id          String   @id @default(cuid())

  applicationId String?
  application   RentalApplication? @relation(fields: [applicationId], references: [id])

  // Applicant info
  firstName   String
  lastName    String
  email       String
  ssn         String?  // Encrypted
  dateOfBirth DateTime?

  // Screening status
  status      ScreeningStatus @default(PENDING)
  result      ScreeningResult @default(PENDING)

  // Screening results
  creditScore Int?
  creditReport Json?
  criminalReport Json?
  evictionReport Json?
  incomeVerification Json?

  // Scores and flags
  overallScore Int?
  flags       String[]  @default([])
  notes       String?

  // Provider info
  providerName String?
  providerReportId String?

  // Multi-tenant
  organizationId String

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([applicationId])
  @@index([status])
  @@index([result])
}

// ============================================================================
// RENTAL APPLICATIONS (Phase 118)
// ============================================================================

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SCREENING
  APPROVED
  CONDITIONALLY_APPROVED
  DENIED
  WITHDRAWN
  LEASE_SIGNED
}

model RentalApplication {
  id          String   @id @default(cuid())

  organizationId String

  // Property/Unit applied for
  propertyId  String?
  unitId      String?

  status      ApplicationStatus @default(DRAFT)

  // Applicant info
  firstName   String
  lastName    String
  email       String
  phone       String
  dateOfBirth DateTime?

  // Current address
  currentAddress String?
  currentCity    String?
  currentState   String?
  currentZip     String?
  currentLandlord String?
  currentLandlordPhone String?
  currentRent    Decimal? @db.Decimal(10, 2)
  moveInReason   String?

  // Employment
  employer    String?
  jobTitle    String?
  employerPhone String?
  monthlyIncome Decimal? @db.Decimal(10, 2)
  employmentLength String?

  // Additional info
  pets        Json?    // [{type, breed, weight}]
  vehicles    Json?    // [{make, model, year, plate}]
  occupants   Json?    // [{name, relationship, age}]

  // Emergency contact
  emergencyContact String?
  emergencyPhone   String?
  emergencyRelation String?

  // Consent
  consentBackgroundCheck Boolean @default(false)
  consentCreditCheck     Boolean @default(false)

  // Documents
  documents   String[] @default([])

  // Decision
  decisionDate DateTime?
  decisionBy   String?
  decisionNotes String?

  // Fees
  applicationFee Decimal? @db.Decimal(10, 2)
  feePaymentId   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  screenings  TenantScreening[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([email])
}

// ============================================================================
// MOVE-IN/MOVE-OUT CHECKLISTS (Phase 120)
// ============================================================================

enum InspectionType {
  MOVE_IN
  MOVE_OUT
  ROUTINE
  MAINTENANCE
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InspectionChecklist {
  id          String   @id @default(cuid())

  leaseId     String
  unitId      String

  type        InspectionType
  status      InspectionStatus @default(SCHEDULED)

  // Schedule
  scheduledDate DateTime?
  completedDate DateTime?

  // Inspector
  inspectorId   String?
  inspectorName String?

  // Checklist items (JSON array of items with room, item, condition, notes, photos)
  items       Json     @default("[]")

  // Summary
  overallCondition String?  // "Excellent", "Good", "Fair", "Poor"
  notes       String?  @db.Text

  // Photos
  photos      String[] @default([])

  // Signatures
  inspectorSignature String?
  tenantSignature    String?
  signedAt           DateTime?

  // Security deposit impact
  damagesFound       Boolean @default(false)
  estimatedRepairCost Decimal? @db.Decimal(10, 2)

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([leaseId])
  @@index([unitId])
  @@index([type])
  @@index([status])
}

// ============================================================================
// OWNER PORTAL (Phase 122)
// ============================================================================

model Owner {
  id          String   @id @default(cuid())

  // Owner info
  firstName   String
  lastName    String
  email       String
  phone       String?

  // Company info (for entity owners)
  companyName String?
  taxId       String?

  // Address
  address1    String?
  address2    String?
  city        String?
  state       String?
  zipCode     String?

  // Portal access
  portalEnabled Boolean @default(false)
  portalPassword String?
  lastPortalLogin DateTime?

  // Payment info for distributions
  paymentMethod String?  // "ACH", "Check", "Wire"
  bankAccountNumber String?
  bankRoutingNumber String?
  bankAccountName   String?

  // Multi-tenant
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  properties  PropertyOwner[]

  @@index([organizationId])
  @@index([email])
}

model PropertyOwner {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Ownership details
  ownershipPercentage Decimal @db.Decimal(5, 2) @default(100)
  isPrimaryOwner      Boolean @default(true)

  // Distribution settings
  distributionMethod  String?  // "percentage", "fixed"
  distributionAmount  Decimal? @db.Decimal(10, 2)

  startDate   DateTime @default(now())
  endDate     DateTime?

  createdAt   DateTime @default(now())

  @@unique([propertyId, ownerId])
  @@index([propertyId])
  @@index([ownerId])
}

// ============================================================================
// OWNER STATEMENTS (Phase 123)
// ============================================================================

enum StatementPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum StatementStatus {
  DRAFT
  GENERATED
  SENT
  VIEWED
}

model OwnerStatement {
  id          String   @id @default(cuid())

  ownerId     String
  propertyId  String?  // null = all properties

  period      StatementPeriod
  status      StatementStatus @default(DRAFT)

  // Period dates
  startDate   DateTime
  endDate     DateTime

  // Financial summary
  grossIncome     Decimal @db.Decimal(15, 2) @default(0)
  totalExpenses   Decimal @db.Decimal(15, 2) @default(0)
  netIncome       Decimal @db.Decimal(15, 2) @default(0)
  managementFee   Decimal @db.Decimal(15, 2) @default(0)
  ownerDraw       Decimal @db.Decimal(15, 2) @default(0)

  // Detailed breakdown (JSON)
  incomeDetails   Json    @default("[]")
  expenseDetails  Json    @default("[]")

  // Document
  documentUrl     String?
  sentAt          DateTime?
  viewedAt        DateTime?

  // Multi-tenant
  organizationId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([ownerId])
  @@index([propertyId])
  @@index([status])
}

// ============================================================================
// OWNER DISTRIBUTIONS (Phase 124)
// ============================================================================

enum DistributionStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model OwnerDistribution {
  id          String   @id @default(cuid())

  ownerId     String
  statementId String?

  status      DistributionStatus @default(PENDING)

  // Amount
  amount      Decimal @db.Decimal(15, 2)

  // Payment details
  paymentMethod String?  // "ACH", "Check", "Wire"
  paymentReference String?
  checkNumber String?

  // Dates
  scheduledDate DateTime?
  processedDate DateTime?

  notes       String?

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
}

// ============================================================================
// PORTFOLIO ANALYTICS (Phase 125)
// ============================================================================

model PortfolioSnapshot {
  id          String   @id @default(cuid())

  // Snapshot date
  snapshotDate DateTime

  // Portfolio metrics
  totalProperties     Int      @default(0)
  totalUnits          Int      @default(0)
  occupiedUnits       Int      @default(0)
  vacantUnits         Int      @default(0)
  occupancyRate       Decimal  @db.Decimal(5, 2) @default(0)

  // Financial metrics
  totalMonthlyRent    Decimal  @db.Decimal(15, 2) @default(0)
  totalCollected      Decimal  @db.Decimal(15, 2) @default(0)
  collectionRate      Decimal  @db.Decimal(5, 2) @default(0)
  totalOutstanding    Decimal  @db.Decimal(15, 2) @default(0)

  // Work orders
  openWorkOrders      Int      @default(0)
  completedWorkOrders Int      @default(0)
  avgCompletionDays   Decimal? @db.Decimal(5, 1)

  // Leases
  expiringLeases30    Int      @default(0)
  expiringLeases60    Int      @default(0)
  expiringLeases90    Int      @default(0)

  // Revenue metrics
  netOperatingIncome  Decimal? @db.Decimal(15, 2)
  expenseRatio        Decimal? @db.Decimal(5, 2)

  // By property breakdown (JSON)
  propertyBreakdown   Json     @default("[]")

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())

  @@unique([organizationId, snapshotDate])
  @@index([organizationId])
  @@index([snapshotDate])
}

// ============================================================================
// BUDGETING (Phase 126)
// ============================================================================

model PropertyBudget {
  id          String   @id @default(cuid())

  propertyId  String

  // Budget period
  year        Int
  month       Int?     // null = annual budget

  // Budget line items (JSON array)
  lineItems   Json     @default("[]")

  // Totals
  totalBudgeted   Decimal @db.Decimal(15, 2) @default(0)
  totalActual     Decimal @db.Decimal(15, 2) @default(0)
  variance        Decimal @db.Decimal(15, 2) @default(0)

  // Status
  isApproved  Boolean  @default(false)
  approvedBy  String?
  approvedAt  DateTime?

  notes       String?

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, year, month])
  @@index([organizationId])
  @@index([propertyId])
  @@index([year])
}

// ============================================================================
// 1099 GENERATION (Phase 127)
// ============================================================================

enum Form1099Status {
  DRAFT
  GENERATED
  SENT
  FILED
}

model Form1099 {
  id          String   @id @default(cuid())

  vendorId    String?
  ownerId     String?

  taxYear     Int
  status      Form1099Status @default(DRAFT)

  // Recipient info
  recipientName    String
  recipientTaxId   String?
  recipientAddress String?

  // Amounts by box
  box1Rents           Decimal? @db.Decimal(15, 2)
  box2Royalties       Decimal? @db.Decimal(15, 2)
  box3OtherIncome     Decimal? @db.Decimal(15, 2)
  box7NonemployeeComp Decimal? @db.Decimal(15, 2)

  totalAmount     Decimal @db.Decimal(15, 2) @default(0)

  // Document
  documentUrl     String?
  sentAt          DateTime?
  filedAt         DateTime?

  // Multi-tenant
  organizationId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([vendorId])
  @@index([ownerId])
  @@index([taxYear])
  @@index([status])
}

// ============================================================================
// CAM RECONCILIATION (Phase 128)
// ============================================================================

model CAMPool {
  id          String   @id @default(cuid())

  propertyId  String
  name        String   // "Common Area Maintenance", "Operating Expenses"

  // Budget
  annualBudget    Decimal @db.Decimal(15, 2) @default(0)
  actualExpenses  Decimal @db.Decimal(15, 2) @default(0)

  // Allocation method
  allocationMethod String @default("pro_rata")  // "pro_rata", "fixed", "square_footage"

  // Period
  year        Int

  isActive    Boolean  @default(true)

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  charges     CAMCharge[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([year])
}

model CAMCharge {
  id          String   @id @default(cuid())

  poolId      String
  pool        CAMPool  @relation(fields: [poolId], references: [id], onDelete: Cascade)

  leaseId     String

  // Charge details
  estimatedAmount Decimal @db.Decimal(10, 2) @default(0)
  actualAmount    Decimal @db.Decimal(10, 2) @default(0)
  adjustmentAmount Decimal @db.Decimal(10, 2) @default(0)

  // Period
  year        Int
  month       Int?

  // Billing
  billedDate  DateTime?
  chargeId    String?  // Link to Charge record

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([poolId])
  @@index([leaseId])
  @@index([year])
}

// ============================================================================
// UTILITY BILLING / RUBS (Phase 129)
// ============================================================================

enum UtilityType {
  WATER
  ELECTRIC
  GAS
  SEWER
  TRASH
  CABLE
  INTERNET
  OTHER
}

enum AllocationMethod {
  EQUAL
  SQUARE_FOOTAGE
  OCCUPANCY
  SUBMETER
  FIXED
}

model UtilityAccount {
  id          String   @id @default(cuid())

  propertyId  String
  utilityType UtilityType
  accountNumber String?
  providerName String?

  // Allocation settings
  allocationMethod AllocationMethod @default(EQUAL)

  // Markup (for RUBS)
  markupPercent   Decimal @db.Decimal(5, 2) @default(0)
  adminFee        Decimal @db.Decimal(10, 2) @default(0)

  isActive    Boolean  @default(true)

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  readings    UtilityReading[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([utilityType])
}

model UtilityReading {
  id          String   @id @default(cuid())

  accountId   String
  account     UtilityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Reading details
  readingDate DateTime
  meterReading Decimal? @db.Decimal(15, 4)
  totalAmount  Decimal  @db.Decimal(10, 2)

  // Billing period
  periodStart DateTime
  periodEnd   DateTime

  // Bill document
  billUrl     String?

  // Allocation status
  isAllocated Boolean  @default(false)
  allocatedAt DateTime?

  createdAt   DateTime @default(now())

  @@index([accountId])
  @@index([readingDate])
}

// ============================================================================
// LEASE RENEWALS AUTOMATION (Phase 130)
// ============================================================================

enum RenewalStatus {
  PENDING
  OFFER_SENT
  ACCEPTED
  DECLINED
  NEGOTIATING
  RENEWED
  EXPIRED
}

model LeaseRenewal {
  id          String   @id @default(cuid())

  leaseId     String

  status      RenewalStatus @default(PENDING)

  // Current terms
  currentRent     Decimal @db.Decimal(10, 2)
  currentEndDate  DateTime

  // Proposed terms
  proposedRent    Decimal? @db.Decimal(10, 2)
  proposedStartDate DateTime?
  proposedEndDate DateTime?
  proposedTermMonths Int?

  // Rent increase
  increasePercent Decimal? @db.Decimal(5, 2)
  increaseAmount  Decimal? @db.Decimal(10, 2)

  // Communication tracking
  offerSentDate   DateTime?
  responseDate    DateTime?
  remindersSent   Int      @default(0)
  lastReminderDate DateTime?

  // Tenant response
  tenantNotes     String?
  counterOffer    Decimal? @db.Decimal(10, 2)

  // New lease (if renewed)
  newLeaseId      String?

  // Multi-tenant
  organizationId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([leaseId])
  @@index([status])
}

// ============================================================================
// MARKET RENT ANALYSIS (Phase 131)
// ============================================================================

model MarketRentComp {
  id          String   @id @default(cuid())

  propertyId  String?  // null = general market comp
  unitId      String?

  // Comp details
  address     String
  city        String
  state       String
  zipCode     String

  // Unit details
  bedrooms    Int
  bathrooms   Decimal  @db.Decimal(3, 1)
  squareFeet  Int?
  unitType    String?

  // Rent info
  askingRent  Decimal  @db.Decimal(10, 2)
  effectiveRent Decimal? @db.Decimal(10, 2)

  // Additional info
  amenities   String[] @default([])
  source      String?  // "Zillow", "Apartments.com", "Manual"
  sourceUrl   String?
  listingDate DateTime?

  // Analysis
  pricePerSqFt Decimal? @db.Decimal(10, 2)
  notes       String?

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([city, state])
  @@index([bedrooms])
}

// ============================================================================
// VACANCY LOSS TRACKING (Phase 132)
// ============================================================================

enum VacancyReason {
  LEASE_END
  EVICTION
  EARLY_TERMINATION
  UNIT_RENOVATION
  MARKET_CONDITIONS
  OTHER
}

model VacancyRecord {
  id          String   @id @default(cuid())

  unitId      String
  propertyId  String

  // Vacancy period
  startDate   DateTime
  endDate     DateTime?
  daysVacant  Int?

  // Previous lease
  previousLeaseId String?
  previousRent    Decimal? @db.Decimal(10, 2)

  // Vacancy details
  reason      VacancyReason?
  reasonNotes String?

  // Revenue loss
  marketRent      Decimal? @db.Decimal(10, 2)
  dailyLoss       Decimal? @db.Decimal(10, 2)
  totalLoss       Decimal? @db.Decimal(15, 2)

  // Turnover costs
  turnoverCost    Decimal? @db.Decimal(10, 2)
  turnoverNotes   String?

  // Marketing
  marketingStartDate DateTime?
  listingPrice    Decimal? @db.Decimal(10, 2)
  showings        Int      @default(0)
  applications    Int      @default(0)

  // Resolution
  newLeaseId      String?

  // Multi-tenant
  organizationId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([startDate])
}
