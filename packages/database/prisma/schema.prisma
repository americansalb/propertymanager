// PropertyMaster - Database Schema
// Multi-tenant, ACID-compliant schema for enterprise property management

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANCY & USER MANAGEMENT
// ============================================================================

enum UserRole {
  SUPER_ADMIN      // Platform admin
  ORGANIZATION_ADMIN // Company owner
  PROPERTY_MANAGER
  ACCOUNTANT
  LEASING_AGENT
  MAINTENANCE_TECH
  TENANT
  VENDOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      OrganizationType

  // Branding
  logoUrl   String?
  primaryColor String?

  // Subscription & Billing
  plan      SubscriptionPlan @default(TRIAL)
  stripeCustomerId String? @unique

  // Settings
  settings  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users     User[]
  properties Property[]
  chartOfAccounts ChartOfAccounts[]
  vendors   Vendor[]
  bankAccounts BankAccount[]
  events    Event[]

  @@index([slug])
}

enum OrganizationType {
  PROPERTY_MANAGER
  OWNER_OPERATOR
  ENTERPRISE
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String

  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?

  role          UserRole
  status        UserStatus @default(ACTIVE)

  // Multi-tenant
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Security
  emailVerified Boolean  @default(false)
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  lastLoginAt   DateTime?

  // Account lockout
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  lastFailedLoginAt DateTime?
  passwordChangedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdTransactions Transaction[]
  assignedWorkOrders WorkOrder[]
  auditLogs      AuditLog[]
  events         Event[]
  deviceTokens   DeviceToken[]
  refreshTokens  RefreshToken[]
  apiKeys        ApiKey[]

  @@index([organizationId])
  @@index([email])
}

// ============================================================================
// PROPERTY & UNIT MANAGEMENT
// ============================================================================

enum PropertyType {
  MULTIFAMILY
  SINGLE_FAMILY
  COMMERCIAL
  MIXED_USE
  STUDENT_HOUSING
  SENIOR_LIVING
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_CONSTRUCTION
}

model Property {
  id          String   @id @default(cuid())

  // Basic Info
  name        String
  type        PropertyType
  status      PropertyStatus @default(ACTIVE)

  // Address
  address1    String
  address2    String?
  city        String
  state       String
  zipCode     String
  country     String   @default("US")
  latitude    Float?
  longitude   Float?

  // Details
  yearBuilt   Int?
  totalUnits  Int
  squareFeet  Int?

  // Financial
  acquisitionDate DateTime?
  acquisitionCost Decimal? @db.Decimal(15, 2)

  // Multi-tenant
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Settings
  settings    Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  units       Unit[]
  accounts    Account[]
  workOrders  WorkOrder[]
  vendors     PropertyVendor[]

  @@index([organizationId])
  @@index([status])
}

enum UnitType {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_PLUS_BED
  COMMERCIAL
}

enum UnitStatus {
  VACANT
  OCCUPIED
  VACANT_RENTED // Rented but not moved in
  NOTICE
  MAINTENANCE
}

model Unit {
  id          String   @id @default(cuid())

  // Identification
  unitNumber  String
  floor       Int?
  type        UnitType
  status      UnitStatus @default(VACANT)

  // Physical details
  bedrooms    Int
  bathrooms   Decimal  @db.Decimal(3, 1)
  squareFeet  Int?

  // Financial
  marketRent  Decimal  @db.Decimal(10, 2)

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  leases      Lease[]
  workOrders  WorkOrder[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
}

// ============================================================================
// LEASING & TENANTS
// ============================================================================

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum LeaseType {
  FIXED_TERM
  MONTH_TO_MONTH
  COMMERCIAL
}

model Lease {
  id          String   @id @default(cuid())

  status      LeaseStatus @default(DRAFT)
  type        LeaseType

  // Dates
  startDate   DateTime
  endDate     DateTime?
  moveInDate  DateTime?
  moveOutDate DateTime?
  noticeDate  DateTime?

  // Financial terms
  monthlyRent Decimal  @db.Decimal(10, 2)
  securityDeposit Decimal @db.Decimal(10, 2)

  // Auto-pay settings
  autoPayEnabled Boolean @default(false)
  autoPayDay     Int?    // Day of month (1-28) when auto-pay runs
  autoPayPaymentMethodId String? // Stripe payment method ID

  // Lease terms
  terms       Json     @default("{}")
  documentUrl String?

  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenants     Tenant[]
  charges     Charge[]

  @@index([unitId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([autoPayEnabled])
}

model Tenant {
  id          String   @id @default(cuid())

  // Personal info
  firstName   String
  lastName    String
  email       String
  phone       String

  // Emergency contact
  emergencyContact  String?
  emergencyPhone    String?
  emergencyContactName  String?  // Legacy field, use emergencyContact
  emergencyContactPhone String?  // Legacy field, use emergencyPhone

  // Linked user account (for portal access)
  userId      String?  @unique

  // Portal access
  portalEnabled     Boolean  @default(false)
  portalPassword    String?
  lastPortalLogin   DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?

  // Account lockout
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?

  // Stripe integration for payments
  stripeCustomerId String? @unique

  leaseId     String
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  isPrimary   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  payments    Payment[]
  maintenanceRequests MaintenanceRequest[]
  messages    TenantMessage[]

  @@index([leaseId])
  @@index([email])
  @@index([portalEnabled])
}

// ============================================================================
// FINANCIAL CORE - CHART OF ACCOUNTS
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  // Assets
  CASH
  ACCOUNTS_RECEIVABLE
  SECURITY_DEPOSITS_HELD
  FIXED_ASSETS

  // Liabilities
  ACCOUNTS_PAYABLE
  SECURITY_DEPOSITS_LIABILITY
  LOANS_PAYABLE

  // Equity
  OWNER_EQUITY
  RETAINED_EARNINGS

  // Revenue
  RENTAL_INCOME
  LATE_FEES
  PARKING_INCOME
  AMENITY_FEES
  OTHER_INCOME

  // Expenses
  MAINTENANCE
  UTILITIES
  INSURANCE
  PROPERTY_TAX
  MANAGEMENT_FEES
  MARKETING
  PAYROLL
  OTHER_EXPENSE
}

model ChartOfAccounts {
  id            String   @id @default(cuid())

  accountNumber String
  name          String
  type          AccountType
  subType       AccountSubType

  description   String?
  isActive      Boolean  @default(true)

  // Multi-tenant
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts      Account[]
  journalEntries JournalEntry[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([type])
}

// Property-level GL Account
model Account {
  id          String   @id @default(cuid())

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  coaId       String
  chartOfAccount ChartOfAccounts @relation(fields: [coaId], references: [id])

  balance     Decimal  @db.Decimal(15, 2) @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalEntries JournalEntry[]

  @@index([propertyId])
  @@index([coaId])
}

// ============================================================================
// FINANCIAL CORE - TRANSACTIONS & JOURNAL ENTRIES
// ============================================================================

enum TransactionType {
  CHARGE
  PAYMENT
  REFUND
  ADJUSTMENT
  JOURNAL_ENTRY
}

enum TransactionStatus {
  PENDING
  POSTED
  VOID
  RECONCILED
}

model Transaction {
  id          String   @id @default(cuid())

  type        TransactionType
  status      TransactionStatus @default(PENDING)

  amount      Decimal  @db.Decimal(15, 2)
  description String

  transactionDate DateTime
  postDate    DateTime?

  // Reference
  referenceType String? // "Lease", "WorkOrder", "Vendor", etc.
  referenceId   String?

  // Audit
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalEntries JournalEntry[]

  @@index([transactionDate])
  @@index([status])
  @@index([referenceType, referenceId])
}

// Double-entry bookkeeping
model JournalEntry {
  id          String   @id @default(cuid())

  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])

  coaId       String
  chartOfAccount ChartOfAccounts @relation(fields: [coaId], references: [id])

  // Debit or Credit
  debit       Decimal  @db.Decimal(15, 2) @default(0)
  credit      Decimal  @db.Decimal(15, 2) @default(0)

  memo        String?

  createdAt   DateTime @default(now())

  @@index([transactionId])
  @@index([accountId])
}

// ============================================================================
// ACCOUNTS RECEIVABLE (AR)
// ============================================================================

enum ChargeType {
  RENT
  LATE_FEE
  PET_FEE
  PARKING
  AMENITY
  UTILITY
  NSF_FEE
  DAMAGE
  OTHER
}

enum ChargeStatus {
  PENDING
  POSTED
  PAID
  PARTIALLY_PAID
  VOID
}

model Charge {
  id          String   @id @default(cuid())

  leaseId     String
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  type        ChargeType
  status      ChargeStatus @default(PENDING)

  amount      Decimal  @db.Decimal(10, 2)
  amountPaid  Decimal  @db.Decimal(10, 2) @default(0)

  description String
  dueDate     DateTime
  postDate    DateTime?

  // Recurring
  isRecurring Boolean  @default(false)
  recurringRuleId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  payments    PaymentAllocation[]

  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
}

enum PaymentMethod {
  ACH
  CREDIT_CARD
  DEBIT_CARD
  CHECK
  CASH
  WIRE_TRANSFER
  MONEY_ORDER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  amount      Decimal  @db.Decimal(10, 2)

  // Payment processor integration
  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  // Check/Money Order details
  checkNumber String?

  paymentDate DateTime
  depositDate DateTime?

  memo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  allocations PaymentAllocation[]

  @@index([tenantId])
  @@index([status])
  @@index([paymentDate])
  @@index([stripePaymentIntentId])
}

// Payment allocation to charges
model PaymentAllocation {
  id          String   @id @default(cuid())

  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  chargeId    String
  charge      Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([chargeId])
}

// ============================================================================
// ACCOUNTS PAYABLE (AP)
// ============================================================================

enum VendorType {
  MAINTENANCE
  LANDSCAPING
  CLEANING
  PLUMBING
  ELECTRICAL
  HVAC
  LOCKSMITH
  GENERAL_CONTRACTOR
  SUPPLIER
  UTILITY
  PROFESSIONAL_SERVICES
  OTHER
}

enum VendorStatus {
  PENDING_APPROVAL  // Awaiting admin review
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED          // Application rejected
}

model Vendor {
  id          String   @id @default(cuid())

  // Basic info
  companyName String
  contactName String?
  email       String?
  phone       String?

  type        VendorType
  status      VendorStatus @default(PENDING_APPROVAL)

  // Address
  address1    String?
  address2    String?
  city        String?
  state       String?
  zipCode     String?

  // Tax info
  taxId       String?
  w9Url       String?

  // Payment info
  paymentTerms String?   // "Net 30", etc.
  defaultPaymentMethod PaymentMethod?

  // Insurance & compliance
  insuranceExpiryDate DateTime?
  insuranceCertUrl    String?
  licenseNumber       String?
  licenseExpiryDate   DateTime?

  // Approval tracking
  approvalNotes       String?  @db.Text  // Admin notes during review
  approvedByUserId    String?            // User who approved/rejected
  approvedAt          DateTime?          // When approved/rejected
  rejectionReason     String?  @db.Text  // If rejected, why

  // User account (for vendor portal access)
  userId          String?  @unique       // Linked user account for portal login

  // Multi-tenant
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  properties  PropertyVendor[]
  bills       Bill[]
  workOrders  WorkOrder[]
  marketplaceProfile VendorMarketplaceProfile?

  @@index([organizationId])
  @@index([status])
}

// Many-to-many: Vendors approved for specific properties
model PropertyVendor {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  isPreferred Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@unique([propertyId, vendorId])
  @@index([propertyId])
  @@index([vendorId])
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  VOID
  OVERDUE
}

model Bill {
  id          String   @id @default(cuid())

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  status      BillStatus @default(DRAFT)

  // Bill details
  billNumber  String?
  amount      Decimal  @db.Decimal(15, 2)

  billDate    DateTime
  dueDate     DateTime
  paidDate    DateTime?

  description String

  // Document (AI-ingested invoice)
  documentUrl String?
  ocrData     Json?    // AI-extracted data

  // Reference to work order, property, etc.
  workOrderId String?
  propertyId  String?

  memo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@index([workOrderId])
}

// ============================================================================
// BANK RECONCILIATION
// ============================================================================

enum BankAccountType {
  CHECKING
  SAVINGS
  TRUST_ACCOUNT
}

model BankAccount {
  id          String   @id @default(cuid())

  accountName String
  accountType BankAccountType

  bankName    String
  accountNumber String  // Last 4 digits only
  routingNumber String?

  currentBalance Decimal @db.Decimal(15, 2) @default(0)

  // Plaid integration
  plaidAccessToken String?
  plaidItemId      String?
  plaidAccountId   String?

  isActive    Boolean  @default(true)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bankTransactions BankTransaction[]

  @@index([organizationId])
}

enum BankTransactionStatus {
  PENDING
  CLEARED
  RECONCILED
}

model BankTransaction {
  id          String   @id @default(cuid())

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  status      BankTransactionStatus @default(PENDING)

  transactionDate DateTime
  amount      Decimal  @db.Decimal(15, 2)
  description String

  // Plaid data
  plaidTransactionId String? @unique
  merchantName       String?
  category           String[]

  // Manual reconciliation
  matchedTransactionId String? @unique
  reconciledAt         DateTime?
  reconciledBy         String?

  createdAt   DateTime @default(now())

  @@index([bankAccountId])
  @@index([status])
  @@index([transactionDate])
}

// ============================================================================
// OPERATIONS - WORK ORDERS & MAINTENANCE
// ============================================================================

enum WorkOrderType {
  MAINTENANCE
  REPAIR
  INSPECTION
  TURNOVER
  EMERGENCY
  PREVENTIVE
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum WorkOrderStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id             String   @id @default(cuid())
  organizationId String

  title       String
  description String
  type        WorkOrderType
  priority    WorkOrderPriority @default(MEDIUM)
  status      WorkOrderStatus   @default(SUBMITTED)

  // Location
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])

  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])

  location    String?  // "Lobby", "Roof", etc.

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  vendorId    String?
  vendor      Vendor? @relation(fields: [vendorId], references: [id])

  // Dates
  requestedDate DateTime @default(now())
  scheduledDate DateTime?
  completedDate DateTime?

  // Cost
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)

  // Tenant-submitted info
  tenantReportedBy String?
  tenantPhone      String?
  permissionToEnter Boolean @default(false)

  // Completion
  completionNotes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  attachments WorkOrderAttachment[]
  statusHistory WorkOrderStatusHistory[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([vendorId])
}

model WorkOrderAttachment {
  id          String   @id @default(cuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  fileUrl     String
  fileName    String
  fileType    String   // "image/jpeg", etc.
  fileSize    Int

  uploadedBy  String?
  description String?

  createdAt   DateTime @default(now())

  @@index([workOrderId])
}

model WorkOrderStatusHistory {
  id          String   @id @default(cuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus

  changedBy   String
  notes       String?

  createdAt   DateTime @default(now())

  @@index([workOrderId])
}

// ============================================================================
// AUDIT & COMPLIANCE
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PAYMENT_PROCESSED
  DOCUMENT_VIEWED
}

model AuditLog {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  action      AuditAction
  entityType  String   // "Lease", "Payment", "WorkOrder", etc.
  entityId    String

  ipAddress   String?
  userAgent   String?

  changes     Json?    // Before/after snapshot

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// ANALYTICS & FEATURE TRACKING
// ============================================================================

model Event {
  id             String   @id @default(cuid())

  // Event identification
  name           String   // e.g., "property_created", "modal_opened", "report_generated"
  category       String?  // e.g., "property_management", "financial", "user_interaction"

  // Context
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Metadata (flexible JSON for event-specific data)
  properties     Json     @default("{}")

  // Session tracking
  sessionId      String?

  // Request metadata
  ipAddress      String?
  userAgent      String?
  url            String?

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([name])
  @@index([category])
  @@index([createdAt])
  @@index([sessionId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_REMINDER
  AUTOPAY_UPCOMING
  AUTOPAY_PROCESSED
  AUTOPAY_FAILED
  LEASE_EXPIRING
  LEASE_EXPIRED
  LATE_FEE_APPLIED
  WORK_ORDER_UPDATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

model Notification {
  id          String   @id @default(cuid())

  type        NotificationType
  status      NotificationStatus @default(PENDING)
  channel     NotificationChannel @default(EMAIL)

  // Recipient
  recipientEmail String?
  recipientPhone String?
  recipientUserId String?

  // Content
  subject     String
  body        String   @db.Text
  htmlBody    String?  @db.Text

  // Reference
  referenceType String? // "Lease", "Payment", "Charge", etc.
  referenceId   String?

  // Tracking
  sentAt      DateTime?
  readAt      DateTime?
  errorMessage String?

  // Multi-tenant
  organizationId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([recipientUserId])
  @@index([createdAt])
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json

  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// TENANT PORTAL
// ============================================================================

enum MaintenanceRequestStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceRequestPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

model MaintenanceRequest {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Request details
  title       String
  description String   @db.Text
  category    String   // "Plumbing", "Electrical", "HVAC", "Appliance", "Other"
  priority    MaintenanceRequestPriority @default(MEDIUM)
  status      MaintenanceRequestStatus @default(SUBMITTED)

  // Location
  location    String?  // Specific area within unit

  // Permission
  permissionToEnter Boolean @default(false)
  preferredTimes    String?

  // Photos
  photos      String[] @default([])

  // Resolution
  resolvedAt  DateTime?
  resolution  String?

  // Link to work order
  workOrderId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

enum MessageDirection {
  TENANT_TO_MANAGEMENT
  MANAGEMENT_TO_TENANT
}

model TenantMessage {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  direction   MessageDirection
  subject     String?
  content     String   @db.Text

  // Attachments
  attachments String[] @default([])

  // Read status
  isRead      Boolean  @default(false)
  readAt      DateTime?

  // Reply tracking
  parentId    String?
  parent      TenantMessage? @relation("MessageReplies", fields: [parentId], references: [id])
  replies     TenantMessage[] @relation("MessageReplies")

  // Sender info (for management messages)
  senderName  String?
  senderId    String?

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([direction])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================================================
// MOBILE APP API
// ============================================================================

model DeviceToken {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device info
  platform    String   // "IOS", "ANDROID", "WEB"
  token       String   @unique
  deviceId    String?
  deviceName  String?
  deviceModel String?
  osVersion   String?
  appVersion  String?

  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime @default(now())

  // Notification preferences
  enablePush  Boolean  @default(true)
  enablePaymentAlerts Boolean @default(true)
  enableMaintenanceAlerts Boolean @default(true)
  enableLeaseAlerts Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model RefreshToken {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Token
  token       String   @unique
  tokenHash   String

  // Device association
  deviceId    String?
  userAgent   String?
  ipAddress   String?

  // Validity
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedReason String?

  // Usage tracking
  lastUsedAt  DateTime?
  useCount    Int      @default(0)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ApiKey {
  id          String   @id @default(cuid())

  organizationId String

  // Key info
  name        String
  description String?
  keyHash     String   @unique // Hashed full key
  keyPreview  String   // First few chars for identification

  // Permissions
  scopes      String[] @default(["read"])

  // Rate limiting
  rateLimitPerMinute Int @default(60)
  rateLimitPerDay    Int @default(10000)

  // Restrictions
  allowedIps     String[] @default([])
  allowedOrigins String[] @default([])

  // Status
  isActive    Boolean  @default(true)

  // Validity
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)

  // Creator
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([keyHash])
  @@index([createdById])
}

// ============================================================================
// DOCUMENT MANAGEMENT
// ============================================================================

enum DocumentType {
  LEASE_AGREEMENT
  LEASE_ADDENDUM
  MOVE_IN_CHECKLIST
  MOVE_OUT_CHECKLIST
  VENDOR_INSURANCE
  VENDOR_W9
  VENDOR_LICENSE
  VENDOR_CONTRACT
  WORK_ORDER_PHOTO
  WORK_ORDER_INVOICE
  MAINTENANCE_PHOTO
  PROPERTY_PHOTO
  UNIT_PHOTO
  OTHER
}

model Document {
  id          String   @id @default(cuid())

  // File info
  name        String   // Original filename
  description String?
  type        DocumentType @default(OTHER)

  // Storage info
  storageKey  String   @unique // Key in storage provider
  storageUrl  String   // URL to access file
  storageProvider String // 'local' or 's3'

  // File metadata
  mimeType    String
  size        Int      // File size in bytes

  // Entity association (polymorphic)
  entityType  String   // 'Property', 'Unit', 'Lease', 'Vendor', 'WorkOrder', etc.
  entityId    String

  // Access control
  isPublic    Boolean  @default(false)

  // Multi-tenant
  organizationId String

  // Audit
  uploadedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([type])
  @@index([storageKey])
}

// ============================================================================
// VENDOR MARKETPLACE
// ============================================================================

enum ServiceCategory {
  LOCKSMITH
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE_REPAIR
  CLEANING
  LANDSCAPING
  PEST_CONTROL
  PAINTING
  FLOORING
  ROOFING
  GENERAL_HANDYMAN
  OTHER
}

enum MarketplaceRegion {
  CHICAGO_IL
  // Add more regions as we expand
}

// Standardized service catalog with pricing
model ServiceCatalog {
  id            String   @id @default(cuid())

  // Service identification
  category      ServiceCategory
  name          String   // "Rekey Lock", "Replace Deadbolt", etc.
  description   String?

  // Pricing structure
  requiresQuote     Boolean  @default(false)
  standardQuoteFee  Decimal? @db.Decimal(10, 2) // Fee for quote visit

  // Labor pricing (per hour or flat rate)
  isFlatRate        Boolean  @default(true)
  laborMin          Decimal? @db.Decimal(10, 2)
  laborMax          Decimal? @db.Decimal(10, 2)

  // Parts/materials (typical range)
  partsMin          Decimal? @db.Decimal(10, 2)
  partsMax          Decimal? @db.Decimal(10, 2)

  // Total typical cost range
  typicalTotalMin   Decimal  @db.Decimal(10, 2)
  typicalTotalMax   Decimal  @db.Decimal(10, 2)

  // Time estimate
  typicalDurationMinutes Int?

  // Region-specific pricing
  region            MarketplaceRegion @default(CHICAGO_IL)

  // Status
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  vendorServices    VendorService[]
  marketplaceJobs   MarketplaceJob[]

  @@unique([category, name, region])
  @@index([category])
  @@index([region])
  @@index([isActive])
}

enum VendorTier {
  STANDARD          // Charge what they want
  VERIFIED_PRICING  // Agreed to standardized rates
  PREMIUM           // Top-rated + verified pricing
}

enum VendorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// Extended vendor profile for marketplace
model VendorMarketplaceProfile {
  id            String   @id @default(cuid())

  vendorId      String   @unique
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Marketplace settings
  tier                VendorTier @default(STANDARD)
  isMarketplaceActive Boolean    @default(true)

  // Service area (zip codes they serve)
  serviceZipCodes     String[]   @default([])
  serviceRadius       Int?       // Miles from base location

  // Verification status
  backgroundCheckStatus   VendorVerificationStatus @default(PENDING)
  backgroundCheckDate     DateTime?
  backgroundCheckProvider String?

  insuranceVerified       Boolean   @default(false)
  insuranceVerifiedDate   DateTime?
  insuranceAmount         Decimal?  @db.Decimal(15, 2)

  licenseVerified         Boolean   @default(false)
  licenseVerifiedDate     DateTime?

  // Performance metrics (calculated)
  averageRating           Decimal?  @db.Decimal(3, 2) // 1.00 to 5.00
  totalJobsCompleted      Int       @default(0)
  totalJobsCancelled      Int       @default(0)
  averageResponseMinutes  Int?      // Time to accept jobs
  onTimePercentage        Decimal?  @db.Decimal(5, 2)

  // Payment settings
  stripeConnectAccountId  String?   @unique
  payoutSpeed             String    @default("standard") // "instant" or "standard"

  // Availability
  acceptingJobs           Boolean   @default(true)
  maxConcurrentJobs       Int       @default(5)
  currentActiveJobs       Int       @default(0)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  services                VendorService[]
  marketplaceJobs         MarketplaceJob[]
  ratings                 VendorRating[]
  dispatches              JobDispatch[]

  @@index([tier])
  @@index([isMarketplaceActive])
  @@index([averageRating])
}

// Services a vendor offers with their pricing
model VendorService {
  id            String   @id @default(cuid())

  vendorProfileId String
  vendorProfile   VendorMarketplaceProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  serviceCatalogId String
  serviceCatalog   ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])

  // Custom pricing (if different from catalog)
  customQuoteFee    Decimal? @db.Decimal(10, 2)
  customLaborRate   Decimal? @db.Decimal(10, 2) // Per hour
  customFlatRate    Decimal? @db.Decimal(10, 2) // If flat rate

  // Availability for this service
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([vendorProfileId, serviceCatalogId])
  @@index([vendorProfileId])
  @@index([serviceCatalogId])
}

enum MarketplaceJobSource {
  MARKETPLACE       // Landlord selected from marketplace
  BYOV              // Bring Your Own Vendor
}

enum MarketplaceJobStatus {
  PENDING_DISPATCH  // Waiting for vendor selection
  DISPATCHED        // Sent to vendor(s)
  ACCEPTED          // Vendor accepted
  QUOTE_SUBMITTED   // Vendor submitted quote
  QUOTE_APPROVED    // Landlord approved quote
  QUOTE_DECLINED    // Landlord declined quote
  IN_PROGRESS       // Work started
  COMPLETED         // Work done, pending confirmation
  CONFIRMED         // Landlord confirmed completion
  DISPUTED          // Issue raised
  CANCELLED         // Job cancelled
}

enum ProtectionTier {
  BASIC             // 2-3% - payment only
  PROTECTED         // 10-15% - full guarantees
}

// Marketplace extension of work order
model MarketplaceJob {
  id            String   @id @default(cuid())

  workOrderId   String   @unique

  // Source
  source        MarketplaceJobSource @default(MARKETPLACE)
  status        MarketplaceJobStatus @default(PENDING_DISPATCH)

  // Service
  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  // Assigned vendor
  vendorProfileId String?
  vendorProfile   VendorMarketplaceProfile? @relation(fields: [vendorProfileId], references: [id])

  // Protection tier
  protectionTier ProtectionTier @default(PROTECTED)

  // Pricing
  quoteFee          Decimal? @db.Decimal(10, 2)
  quoteFeePaid      Boolean  @default(false)
  estimatedTotal    Decimal? @db.Decimal(10, 2)
  actualTotal       Decimal? @db.Decimal(10, 2)

  // Platform fees
  platformFeePercent Decimal @db.Decimal(5, 2) @default(12.00)
  platformFeeAmount  Decimal? @db.Decimal(10, 2)

  // Payment escrow
  paymentSecuredAt     DateTime?
  paymentSecuredAmount Decimal? @db.Decimal(10, 2)
  paymentReleasedAt    DateTime?
  paymentReleasedAmount Decimal? @db.Decimal(10, 2)

  // Stripe references
  stripePaymentIntentId String? @unique
  stripeTransferId      String? // Transfer to vendor

  // Scheduling
  scheduledDate      DateTime?
  scheduledTimeSlot  String?   // "9am-12pm", "1pm-5pm", etc.
  vendorEta          DateTime?

  // Completion
  completedAt        DateTime?
  completionPhotos   String[]  @default([])
  completionNotes    String?

  // Confirmation
  confirmedAt        DateTime?
  confirmedBy        String?   // userId

  // Dispute
  disputeStatus      String?   // "OPEN", "RESOLVED", "REFUNDED"
  disputeReason      String?
  disputeResolvedAt  DateTime?
  disputeResolution  String?

  // Guarantee
  workmanshipGuaranteeExpiry DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  dispatches         JobDispatch[]
  rating             VendorRating?

  @@index([workOrderId])
  @@index([status])
  @@index([vendorProfileId])
  @@index([serviceCatalogId])
  @@index([createdAt])
}

enum DispatchStatus {
  PENDING           // Waiting for vendor response
  ACCEPTED          // Vendor accepted
  DECLINED          // Vendor declined
  EXPIRED           // Response window expired
  CANCELLED         // Landlord cancelled
}

// Track job dispatch attempts to vendors
model JobDispatch {
  id            String   @id @default(cuid())

  marketplaceJobId String
  marketplaceJob   MarketplaceJob @relation(fields: [marketplaceJobId], references: [id], onDelete: Cascade)

  vendorProfileId String
  vendorProfile   VendorMarketplaceProfile @relation(fields: [vendorProfileId], references: [id])

  status          DispatchStatus @default(PENDING)

  // Timing
  dispatchedAt    DateTime @default(now())
  respondedAt     DateTime?
  responseDeadline DateTime

  // Response
  declineReason   String?

  createdAt       DateTime @default(now())

  @@unique([marketplaceJobId, vendorProfileId])
  @@index([marketplaceJobId])
  @@index([vendorProfileId])
  @@index([status])
}

// Vendor ratings after job completion
model VendorRating {
  id            String   @id @default(cuid())

  vendorProfileId String
  vendorProfile   VendorMarketplaceProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  marketplaceJobId String @unique
  marketplaceJob   MarketplaceJob @relation(fields: [marketplaceJobId], references: [id], onDelete: Cascade)

  // Ratings (1-5)
  overallRating       Int
  qualityRating       Int?
  communicationRating Int?
  punctualityRating   Int?
  valueRating         Int?

  // Review
  review              String? @db.Text

  // Photos (before/after)
  photos              String[] @default([])

  // Reviewer
  reviewerUserId      String
  reviewerName        String?

  // Visibility
  isPublic            Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([vendorProfileId])
  @@index([overallRating])
  @@index([createdAt])
}
