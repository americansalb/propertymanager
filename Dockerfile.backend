# Multi-stage build for production NestJS backend with frontends
FROM node:20-alpine AS base
RUN npm install -g pnpm@8
WORKDIR /app

# Dependencies stage
FROM base AS dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/frontend-admin/package.json ./packages/frontend-admin/
COPY packages/frontend-tenant/package.json ./packages/frontend-tenant/
RUN pnpm install --frozen-lockfile

# Build stage
FROM base AS build
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages ./packages
COPY . .

# Generate Prisma Client and build database package
RUN cd packages/database && pnpm build

# Build shared package
RUN cd packages/shared && pnpm build

# Build backend
RUN cd packages/backend && pnpm build

# Build admin frontend
RUN cd packages/frontend-admin && pnpm build

# Build tenant frontend (static export)
RUN cd packages/frontend-tenant && pnpm build

# Production stage
FROM node:20-alpine AS production
WORKDIR /app

RUN npm install -g pnpm@8 tsx

# Copy package files
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Copy built application
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/database/dist ./packages/database/dist
COPY --from=build /app/packages/database/prisma ./packages/database/prisma
COPY --from=build /app/packages/database/node_modules/.prisma ./packages/database/node_modules/.prisma

# Copy built frontends for static serving
COPY --from=build /app/packages/frontend-admin/dist ./public
COPY --from=build /app/packages/frontend-tenant/out ./public/tenant

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=90s \
  CMD node -e "require('http').get('http://localhost:3001/api/v1/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Run migrations, seed, then start - all inline
CMD cd /app/packages/database && \
    echo "Running migrations..." && \
    npx prisma migrate deploy && \
    echo "Running seed..." && \
    npx tsx prisma/seed.ts && \
    echo "Starting server..." && \
    cd /app && \
    node packages/backend/dist/main.js
